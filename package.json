{
  "name": "repmate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "pnpm build && playwright test",
    "e2e:only": "playwright test",
    "fetch:media": "tsx scripts/fetch-media.ts",
    "fetch:demos": "tsx scripts/fetch-demos.ts",
    "import:dataset": "tsx scripts/import-dataset.ts",
    "gen:icons": "tsx scripts/gen-icons.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "gen:code": "tsx scripts/gen-code.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.1.0",
    "date-fns": "3.6.0",
    "dexie": "4.0.9",
    "dexie-react-hooks": "1.1.7",
    "fflate": "0.8.2",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.13.3",
    "workbox-core": "7.1.0",
    "workbox-precaching": "7.1.0",
    "workbox-routing": "7.1.0",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@playwright/test": "1.48.2",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "fake-indexeddb": "6.0.0",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vite": "5.4.10",
    "vite-plugin-pwa": "0.20.5",
    "vitest": "2.1.4",
    "workbox-window": "7.1.0"
  }
}
