  "cooldown": "5 min walk + stretch hips, hamstrings, chest, calves",
  "rules": [
    "Stop each set with 2 reps left in the tank (RIR 2). Never train to failure.",
    "Station busy for more than 3 minutes? Use the swap or do the next exercise first.",
    "Keep a resistance band in your bag. It replaces every cable exercise.",
    "Sharp joint pain means stop the exercise. Muscle burn is fine."
  ],
