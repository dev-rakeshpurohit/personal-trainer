        "weeks": [
          3,
          4,
          5,
          6,
          7
        ],
        "rir": 2,
        "note": "Main lifts can go to RIR 1 from week 5"
      },
      {
        "weeks": [
          8
        ],
        "rir": 3,
        "deload": true,
        "note": "Half the sets, same weights"
      }
    ]
  },
