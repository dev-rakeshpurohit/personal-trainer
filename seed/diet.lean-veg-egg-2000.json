        "Sabzi or salad"
      ],
      "proteinG": 31,
      "kcal": 500
    },
    {
      "time": "22:00",
      "meal": "Only if needed",
      "items": [
        "½ scoop whey in water – only if protein < 130 g"
      ],
      "proteinG": 12,
      "kcal": 55,
      "optional": true
    }
  ],
  "habits": [
    {
      "id": "oil",
      "label": "Oil ≤ 4 tsp (20 ml) for the day"
    },
    {
      "id": "water",
      "label": "Water 3–3.5 L",
      "target": 3.0,
      "unit": "L"
    },
    {
      "id": "creatine",
      "label": "Creatine 3–5 g"
    },
    {
      "id": "steps",
      "label": "8,000–10,000 steps",
      "target": 8000,
      "unit": "steps"
    },
    {
      "id": "sleep",
      "label": "Sleep 7–8 h",
      "target": 7,
      "unit": "h"
    }
  ],
  "adjustmentRules": [
    {
      "if": "weeklyLossKg between 0.5 and 0.75",
      "then": "No change"
    },
    {
      "if": "weeklyLossKg < 0.3 for 2 consecutive weeks",
      "then": "+2,000 steps/day first; if still stuck, lunch rice to 50 g (≈ −65 kcal)"
    },
    {
      "if": "weeklyLossKg > 1.0 or strength dropping",
      "then": "Rice back to 100 g, or +1 slice multigrain toast at breakfast (≈ +70 kcal)"
    }
  ],
  "annualChecks": [
    "Lipid profile",
    "HbA1c",
    "Vitamin D",
    "Vitamin B12"
  ]
}