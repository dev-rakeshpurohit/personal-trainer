  ],
  "trainingDay": [
    {
      "time": "08:30",
      "meal": "Pre-gym",
      "items": [
        "Tea or black coffee",
        "4 almonds + 3 walnut halves (or 2 dates)"
      ],
      "proteinG": 2,
      "kcal": 65,
      "skipOnRestDay": true
    },
    {
      "time": "10:45",
      "meal": "Breakfast",
      "items": [
        "1 scoop whey isolate in water",
