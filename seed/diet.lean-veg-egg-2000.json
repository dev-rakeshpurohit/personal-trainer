      ],
      "proteinG": 51,
      "kcal": 390
    },
    {
      "time": "12:30",
      "meal": "Lunch",
      "items": [
        "50 g dry soya chunks (curry/sabzi)",
        "200 g cooked thick moong dal",
        "100 g cooked rice",
        "1 bowl non-starchy sabzi",
        "Salad"
      ],
      "proteinG": 46,
      "kcal": 680
    },
    {
      "time": "15:30",
      "meal": "Snack",
      "items": [
        "250 ml unsweetened soy milk"
      ],
      "rotate": [
        "100 g edamame",
        "30 g roasted chana",
        "1 cup sprouts chaat"
      ],
      "proteinG": 17,
      "kcal": 200
